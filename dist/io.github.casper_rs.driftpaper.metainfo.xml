<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.casper_rs.driftpaper</id>
  <name>driftpaper</name>
  <summary>Animated particle wallpaper for Wayland</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <developer id="io.github.casper_rs">
    <name>Casper Schotman</name>
  </developer>
  <description>
    <p>
      Turns any image into an animated wallpaper. driftpaper finds the subject of the image,
      takes particle colours from it and animates particles, fog and a soft glow around it.
      A settings window lets you pick the image, choose a preset and fine-tune every detail
      while watching the result live on your desktop.
    </p>
    <p>Works on Wayland compositors with wlr-layer-shell, such as COSMIC, Sway, Hyprland and KDE Plasma.</p>
  </description>
  <launchable type="desktop-id">io.github.casper_rs.driftpaper.desktop</launchable>
  <url type="homepage">https://github.com/Casper-RS/driftpaper</url>
  <provides>
    <binary>driftpaper</binary>
    <binary>driftpaper-settings</binary>
  </provides>
  <content_rating type="oars-1.1"/>
